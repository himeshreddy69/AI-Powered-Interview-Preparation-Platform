# ---------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
# Never commit the real `.env` file.
# ---------------------------------------------------------------

# Firebase — used for LOGIN ONLY (email/password + Google sign-in).
# Get these from: Firebase Console > Project settings > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Supabase — used for the DATABASE and FILE STORAGE.
# Get these from: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google Gemini AI — powers question generation and answer scoring.
# Get a free key from: https://aistudio.google.com/apikey
# If this is empty the app runs on canned mock data instead of real AI.
VITE_GEMINI_API_KEY=
